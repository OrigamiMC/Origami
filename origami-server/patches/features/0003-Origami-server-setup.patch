From f50ca1d322934d42bcb3dafa99b1145bdd7c3427 Mon Sep 17 00:00:00 2001
From: Oliver <oschi1303@gmail.com>
Date: Mon, 23 Mar 2026 21:33:32 +0100
Subject: [PATCH 3/3] Origami server setup

---
 net/minecraft/server/Main.java                      | 2 ++
 net/minecraft/server/dedicated/DedicatedServer.java | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index 2ced268..dfb0218 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -66,6 +66,8 @@ public class Main {
     @SuppressForbidden(reason = "System.out needed before bootstrap")
     public static void main(final String[] args) {
         SharedConstants.tryDetectVersion();
+        com.origamimc.origami.api.OrigamiInstanceHolder.setInstance(new com.origamimc.origami.OrigamiImpl());
+        com.origamimc.origami.OrigamiImpl.get().getServer().onBoot(); // Origami - origami server
         OptionParser parser = new OptionParser();
         OptionSpec<Void> nogui = parser.accepts("nogui");
         OptionSpec<Void> initSettings = parser.accepts("initSettings", "Initializes 'server.properties' and 'eula.txt', then quits");
diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index ad60537..759ef66 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -283,6 +283,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
             long levelNanoTime = Util.getNanos();
             this.services.nameToIdCache().resolveOfflineUsers(!this.usesAuthentication());
             LOGGER.info("Preparing level \"{}\"", this.getLevelIdName());
+            com.origamimc.origami.OrigamiImpl.get().getServer().onPrepareLevels(); // Origami - origami server
             this.loadLevel();
             long elapsed = Util.getNanos() - levelNanoTime;
             String time = String.format(Locale.ROOT, "%.3fs", elapsed / 1.0E9);
@@ -316,6 +317,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
 
             this.saveEverything(false, true, true);
             this.notificationManager().serverStarted();
+            com.origamimc.origami.OrigamiImpl.get().getServer().onServerStarted(); // Origami - origami server
             return true;
         }
     }
